@baseUrl = http://localhost:3000
@opponentId = 6acbcdc204bdc52587e4e638

### Create a valid opponent — expect 201
POST {{baseUrl}}/api/opponents
Content-Type: application/json

{
  "name": "  Mark Selby  ",
  "notes": "Club practice partner"
}

### Reject a blank name — expect 400
POST {{baseUrl}}/api/opponents
Content-Type: application/json

{
  "name": "   "
}

### Reject an unexpected field — expect 400
POST {{baseUrl}}/api/opponents
Content-Type: application/json

{
  "name": "John Smith",
  "rating": 5
}

### Get all opponents — expect 200
GET {{baseUrl}}/api/opponents

### Get an existing opponent — expect 200
GET {{baseUrl}}/api/opponents/{{opponentId}}

### Get a nonexistent opponent — expect 404
GET {{baseUrl}}/api/opponents/000000000000000000000000

### Reject an invalid ID — expect 400
GET {{baseUrl}}/api/opponents/not-an-id

### Update an opponent — expect 200
PUT {{baseUrl}}/api/opponents/{{opponentId}}
Content-Type: application/json

{
  "name": "John Smith Updated",
  "notes": "Updated notes"
}

### Reject invalid update data — expect 400
PUT {{baseUrl}}/api/opponents/{{opponentId}}
Content-Type: application/json

{
  "name": ""
}

### Update a nonexistent opponent — expect 404
PUT {{baseUrl}}/api/opponents/000000000000000000000000
Content-Type: application/json

{
  "name": "Nobody"
}

### Delete an opponent — expect 204
DELETE {{baseUrl}}/api/opponents/{{opponentId}}

### Delete the same opponent again — expect 404
DELETE {{baseUrl}}/api/opponents/{{opponentId}}

### Reject deletion of an opponent with matches — expect 409
DELETE {{baseUrl}}/api/opponents/{{opponentId}}

### Unknown endpoint — expect 404 with JSON
GET {{baseUrl}}/api/does-not-exist

### Malformed JSON — expect 400 with JSON
POST {{baseUrl}}/api/opponents
Content-Type: application/json

{
  "name":
}

### Reject an invalid opponent ID on deletion — expect 400
DELETE {{baseUrl}}/api/opponents/not-an-id